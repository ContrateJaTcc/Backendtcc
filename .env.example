# Copie para .env.local e preencha

# Banco de dados (MySQL)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Chave dos logins (texto longo e aleatório)
JWT_SECRET=

# Servidor local
PORT=3000
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://seu-site.vercel.app

# Tarefas agendadas (lembretes, resumo semanal). 0 desliga.
# AGENDADOR=0
# CRON_SECRET=

# E-mail (confirmação de e-mail, esqueci minha senha, código do supremo)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tcccontrateja@gmail.com
# SMTP_PASS=senha-de-app-do-gmail
# SMTP_FROM=ContrateJá <tcccontrateja@gmail.com>
# CONTATO_EMAIL=

# Login com Google
# GOOGLE_CLIENT_ID=

# Avisos no celular (gerar com: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:tcccontrateja@gmail.com

# Supremo entra só com senha, sem código por e-mail
# SUPREMO_SEM_CODIGO=1
