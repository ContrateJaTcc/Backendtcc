{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    { "path": "/tarefas/lembretes", "schedule": "0 11 * * *" },
    { "path": "/tarefas/resumo", "schedule": "0 12 * * 1" },
    { "path": "/tarefas/limpeza", "schedule": "30 6 * * *" }
  ]
}
